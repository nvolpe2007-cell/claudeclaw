# Meme Coin Watcher — environment
# Copy to `.env` (next to this file) and fill in. NEVER commit the real .env.
#   cp .env.example .env  &&  nano .env

# --- Required ---------------------------------------------------------------

# Third-party X (Twitter) data provider key. Cheap default: https://twitterapi.io
X_API_KEY=

# --- Alert channels (set at least ONE) --------------------------------------

# Telegram: a DEDICATED bot token from @BotFather, and your numeric chat id
# from @userinfobot. Send your new bot a message once so it can DM you.
MEMECOIN_TELEGRAM_BOT_TOKEN=
MEMECOIN_TELEGRAM_CHAT_ID=

# Discord: a channel webhook URL
# (Channel Settings > Integrations > Webhooks > New Webhook > Copy URL).
MEMECOIN_DISCORD_WEBHOOK_URL=

# --- Optional ---------------------------------------------------------------

# Birdeye key — enables holder-count + holder-growth momentum in the confirmed
# tier. Without it the watcher still runs; those gates are simply skipped.
BIRDEYE_API_KEY=

# Override the X provider host (default https://api.twitterapi.io).
# X_API_BASE_URL=
