# Polymarket CLOB API credentials
# Get these from https://polymarket.com (connect wallet → API keys)
CLOB_API_URL=https://clob.polymarket.com
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# Polygon EOA private key (must have USDC on Polygon mainnet)
PK=0x...

# Trading parameters (all optional — defaults shown)
MAX_CONCURRENT_MARKETS=10
MIN_SPREAD_CENTS=2
MIN_VOLUME_USD=50000
MIN_PRICE_CENTS=5
MAX_PRICE_CENTS=95
ORDER_SIZE_USDC=25.0
TARGET_PROFIT_CENTS=1
STOP_LOSS_CENTS=3
DAILY_LOSS_LIMIT_USDC=200.0

# Timing
SCAN_INTERVAL_SECONDS=30
REQUOTE_DELAY_SECONDS=1
ORDER_TTL_SECONDS=60
