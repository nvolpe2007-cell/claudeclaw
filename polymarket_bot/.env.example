# ============================================================
# Polymarket CLOB API credentials
# Get these from https://polymarket.com → connect wallet → API keys
# ============================================================
CLOB_API_URL=https://clob.polymarket.com
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# Polygon EOA private key (must have USDC on Polygon mainnet)
PK=0x...

# ============================================================
# Bot mode
# ============================================================
# Set to true to simulate trades without placing real orders
DRY_RUN=true

# Set to false to disable value betting and exit immediately
ENABLE_VALUE_BETTING=true

# ============================================================
# Market filters
# ============================================================
BTC_ONLY=true                  # only trade BTC/Bitcoin markets
MIN_SPREAD_CENTS=2             # minimum bid-ask spread to consider
MIN_VOLUME_USD=50000           # 24h volume floor (USD)
MIN_PRICE_CENTS=5              # ignore tokens near 0% probability
MAX_PRICE_CENTS=95             # ignore tokens near 100% probability

# ============================================================
# Order sizing & risk
# ============================================================
ORDER_SIZE_USDC=25.0           # notional per order in USDC
DAILY_LOSS_LIMIT_USDC=200.0    # hard stop — bot halts if breached
MAX_CONCURRENT_POSITIONS=5     # max open positions at once
MAX_POSITION_PER_TOKEN_USDC=100.0
MAX_POSITION_HOLD_DURATION=300 # force-close after 5 minutes (seconds)

# ============================================================
# Value betting (triangulation) parameters
# ============================================================
MIN_MISPRICING_CENTS=1.0       # trade if mispricing >= this many cents
MARKET_SCAN_INTERVAL_SEC=1.5   # how often to scan markets (seconds)
TARGET_PROFIT_CENTS=1
STOP_LOSS_CENTS=3

# ============================================================
# Notifications (optional — leave blank to disable)
# ============================================================
# Telegram: create a bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: create a webhook in channel settings → Integrations
DISCORD_WEBHOOK_URL=

# ============================================================
# Dashboard
# ============================================================
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8080

# ============================================================
# BTC direction arbitrage (log-normal model vs market price)
# ============================================================
DIRECTION_ENABLED=true
# Minimum divergence between model probability and market price (in cents)
# 4.0 = only bet when our model disagrees by >= 4 cents
DIRECTION_MIN_EDGE_CENTS=4.0
# Only trade markets resolving within this many minutes
DIRECTION_MAX_MINUTES=60.0

# ============================================================
# Copy trading (mirror specific wallets' positions)
# ============================================================
COPY_TRADING_ENABLED=false
# Comma-separated wallet addresses to follow. Grab these from
# polymarket.com/leaderboard or any trader's profile URL (polymarket.com/profile/0x...)
COPY_TRADER_WALLETS=
# Mirror at this fraction of the followed wallet's position size
COPY_RATIO=0.1
# Cap per mirrored position, in USDC
COPY_MAX_POSITION_USDC=50.0
# How often to poll followed wallets for new trades (seconds)
COPY_POLL_INTERVAL_SEC=15.0
