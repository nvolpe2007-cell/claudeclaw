# Google Maps Platform key with Geocoding API, Street View Static API, and
# Maps Static API enabled.
GOOGLE_MAPS_API_KEY=

# Claude API key (picked up by the Anthropic SDK). Alternatively authenticate
# with `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=

# Vision model (default claude-opus-4-8)
#ANTHROPIC_MODEL=claude-opus-4-8

# Postgres connection. If unset, results are stored in data/scans.json —
# fine for the Phase 1 validation run against a small address list.
#DATABASE_URL=postgres://ranker:ranker@localhost:5432/ranker

# Milliseconds between addresses during a scan (default 1100)
#SCAN_DELAY_MS=1100

# Imagery older than this (months) lowers the confidence score (default 24)
#MAX_IMAGE_AGE_MONTHS=24

# Dashboard port (default 8787)
#PORT=8787

# Set to 1 to run the whole pipeline offline with deterministic fixtures
#MOCK=1
