# ── KRAKEN API KEYS ───────────────────────────────────────────────────────────
# Paste your Kraken API key and secret here
# Get them from: kraken.com → Account → Security → API → Create API Key
# Required permissions: Query Funds, Create & Modify Orders, Cancel/Close Orders

KRAKEN_API_KEY=paste_your_api_key_here
KRAKEN_API_SECRET=paste_your_api_secret_here

# ── MODE ──────────────────────────────────────────────────────────────────────
# Start with true — no real money, just logs what the bot would do
# Change to false only when you're confident it's working
PAPER_TRADING=true

# ── SYMBOLS ───────────────────────────────────────────────────────────────────
# Kraken format: XBT/USD (Bitcoin), ETH/USD, SOL/USD, XRP/USD
# NOTE: Kraken uses XBT not BTC for Bitcoin
SYMBOLS=XBT/USD,ETH/USD,SOL/USD,XRP/USD

# ── RISK (optional — defaults are safe) ───────────────────────────────────────
# RISK_PCT=1.0          # % of account risked per trade
# MAX_OPEN_TRADES=3     # max simultaneous trades
# DAILY_LOSS_PCT=3.0    # stop trading if down this % in a day

# ── TELEGRAM ALERTS (optional) ────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
