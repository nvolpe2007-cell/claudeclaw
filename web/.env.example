# Nudge — environment variables
#
# Leave everything unset to run on the local file store (zero setup).
# Fill these in to switch the app to Supabase (Postgres + video storage).
# Copy this file to `.env.local` and paste your project's values.
#
# Find them in the Supabase dashboard:
#   Project Settings → API → Project URL and Project API keys.

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" key — used by the browser (needed for the auth slice).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Never expose this to the browser or commit it.
# Its presence (with the URL above) is what switches the app to Supabase.
SUPABASE_SERVICE_ROLE_KEY=
